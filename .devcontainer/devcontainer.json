{
  "name": "TagUtil Dev Container",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": ["--name", "TagUtil"],
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "vscode",
      "screenResolution": "1600x1000"
    }
  },
  "forwardPorts": [5901, 6080, 9222, 9323],
  "postCreateCommand": "pnpm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "svelte.svelte-vscode",
        "oxc.oxc-vscode",
        "christian-kohler.path-intellisense",
        "vitest.explorer",
        "ms-playwright.playwright"
      ],
      "settings": {
        "[typescript]": {
          "editor.defaultFormatter": "oxc.oxc-vscode"
        },
        "[javascript]": {
          "editor.defaultFormatter": "oxc.oxc-vscode"
        },
        "[json]": {
          "editor.defaultFormatter": "oxc.oxc-vscode"
        },
        "[svelte]": {
          "editor.defaultFormatter": "oxc.oxc-vscode"
        },
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.formatOnSave": true,
        "svelte.enable-ts-plugin": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.oxc": "always",
          "source.organizeImports": "always"
        },
        "explorer.fileNesting.enabled": true,
        "explorer.fileNesting.expand": false,
        "explorer.fileNesting.patterns": {
          "package.json": "pnpm-lock.yaml, pnpm-workspace.yaml, .npmrc",
          "tsconfig.json": "tsconfig.*.json, tsconfig.*.tsbuildinfo",
          ".oxlintrc.json": ".oxfmtrc.json",
          ".gitignore": ".gitattributes",
          "electron.vite.config.ts": "vitest.config.ts"
        },
        "workbench.colorCustomizations": {
          "activityBar.activeBackground": "#decd5b",
          "activityBar.background": "#decd5b",
          "activityBar.foreground": "#15202b",
          "activityBarBadge.background": "#209f8f",
          "activityBarBadge.foreground": "#e7e7e7",
          "activityBar.inactiveForeground": "#15202b99",
          "commandCenter.border": "#15202b99",
          "sash.hoverBorder": "#decd5b",
          "statusBar.background": "#d6c030",
          "statusBar.foreground": "#15202b",
          "statusBarItem.hoverBackground": "#b09d23",
          "statusBarItem.remoteBackground": "#d6c030",
          "statusBarItem.remoteForeground": "#15202b",
          "titleBar.activeBackground": "#d6c030",
          "titleBar.activeForeground": "#15202b",
          "titleBar.inactiveBackground": "#d6c03099",
          "titleBar.inactiveForeground": "#15202b99"
        }
      }
    }
  }
}
